# =============================================================================
# Quantum Minesweeper — example environment
#
# Every application setting is read with the QMS_ prefix (see settings.py).
# Grouped below by what the value decides, ending with the entries that are
# normally set by the image or the platform rather than by hand.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Simulator backend: chppy, stim, or qiskit. Local and browser runs default to
# chppy; a server deployment normally runs stim.
QMS_BACKEND=chppy
# Public origin of this deployment, used for canonical links, Open Graph tags,
# and the sitemap. Include the scheme, or those links are emitted malformed.
# QMS_BASE_URL=https://your-app.a.run.app
# Minutes of silence after which an unfinished game is counted as abandoned.
QMS_ABANDON_THRESHOLD_MIN=30

# --- Access ------------------------------------------------------------------
# Basic Auth over the whole site except /health, /static, /analytics and /app.
# With it on, credentials are required: the process refuses to start without
# them rather than serving the site unprotected.
QMS_ENABLE_AUTH=0
QMS_USER=change-me
QMS_PASS=change-me
# Admin dashboard password. Leave unset to disable the /admin routes entirely.
# The dashboard can read and export the games database, so treat it as a
# credential, not a formality.
QMS_ADMIN_PASS=change-me

# --- Feature flags -----------------------------------------------------------
QMS_ENABLE_HELP=1
QMS_ENABLE_ABOUT=1
# Which games may be reset: never, sandbox, or any.
QMS_RESET_POLICY=sandbox
# Region entanglement probes. How many regions a game gets is chosen in Setup;
# this only decides whether the feature exists at all.
QMS_ENABLE_ENTANGLEMENT_PROBES=1

# --- External links ----------------------------------------------------------
# Each link needs its switch AND its URL: with a switch on and no URL, the
# invitation would point at nothing, so it is not rendered at all.
QMS_ENABLE_TUTORIAL=0
QMS_TUTORIAL_URL=https://example.org/tutorial
QMS_ENABLE_SURVEY=0
QMS_SURVEY_URL=https://example.org/survey
# Google Analytics measurement id. Unset means no analytics tag is rendered.
# In CI this comes from the GA_MEASUREMENT_ID secret, mapped onto this name.
# QMS_GA_MEASUREMENT_ID=

# --- Installable browser app (PWA) -------------------------------------------
# Offer the browser-only build at /app/, so visitors can install it and play
# offline. When offered it also becomes the landing: / redirects to /app/ and
# the game runs in the visitor's browser, while the server-rendered game stays
# at /setup. Set this to 0 to keep / on the server-rendered game and hide /app/.
QMS_ENABLE_BROWSER_APP=1

# --- Browser analytics -------------------------------------------------------
# Accept game reports from browser-only sessions, so the deployment collects the
# same statistics however its players play. Unauthenticated by necessity: a
# browser-only client has no credentials. Set to 0 to collect nothing.
QMS_ENABLE_BROWSER_ANALYTICS=1
# Origins allowed to post them, comma-separated; empty means same-origin only,
# which is what you want when this server hands out the app itself.
QMS_ANALYTICS_ALLOWED_ORIGINS=
# Public-ingest safeguards. Rate limits are per running server process; stored
# browser rows are pruned by age and then capped to the newest rows.
QMS_ANALYTICS_RATE_LIMIT_PER_MINUTE=60
QMS_ANALYTICS_GLOBAL_LIMIT_PER_MINUTE=600
QMS_ANALYTICS_MAX_BROWSER_ROWS=50000
QMS_ANALYTICS_RETENTION_DAYS=365

# =============================================================================
# Normally set for you. Override only if you know why.
# =============================================================================

# Path to a PWA bundle built by scripts/build_browser.py. The Docker image
# builds one and points this at it; a plain local run has none unless you set
# this yourself, and without a bundle the flag above has nothing to enable.
QMS_BROWSER_DIST_DIR=

# Where a browser build posts its reports, baked in when the bundle is built.
# Relative, so a bundle reports to whichever origin serves it and one build
# works on any host; set it empty to build an app that reports nothing.
QMS_BROWSER_ANALYTICS_URL=/analytics

# Where the SQLite database lives. The Docker image does NOT take this from the
# environment: scripts/entrypoint.sh copies the persisted database from the
# /data volume into /tmp at startup, exports this variable pointing there, and
# copies it back every 30 minutes and on shutdown — SQLite runs on local disk
# rather than over a network mount, where file locking is not dependable.
# Outside that image it is honoured: set it to keep the database somewhere that
# survives, or leave it unset to let the app choose (a writable /data first,
# then an XDG-style user directory, then ./qms_data).
# QMS_DB_PATH=

# Port to serve on. Cloud Run injects this; local scripts read it.
PORT=8080
